{
  "name": "memoka",
  "private": true,
  "version": "0.1.8",
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json --pretty false && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri:dev": "tauri dev --no-watch",
    "tauri:build": "node scripts/build-tauri.mjs",
    "tauri:e2e": "bash scripts/run-tauri-e2e.sh",
    "tauri:search-e2e": "MEMOKA_E2E_SEARCH_ONLY=1 bash scripts/run-tauri-e2e.sh",
    "tauri:utilities-e2e": "MEMOKA_E2E_UTILITIES_ONLY=1 bash scripts/run-tauri-e2e.sh",
    "tauri:sidebar-focus-e2e": "MEMOKA_E2E_SIDEBAR_FOCUS_ONLY=1 bash scripts/run-tauri-e2e.sh",
    "tauri:window-chrome-e2e": "MEMOKA_E2E_WINDOW_CHROME_ONLY=1 bash scripts/run-tauri-e2e.sh",
    "tauri:attachment-e2e": "MEMOKA_E2E_ATTACHMENT_ONLY=1 bash scripts/run-tauri-e2e.sh",
    "cli:build": "cargo build --release -p memoka-desktop --bin memoka-cli",
    "release:config": "node scripts/prepare-release-config.mjs",
    "release:check-version": "node scripts/check-release-version.mjs",
    "release:notices": "node scripts/generate-third-party-notices.mjs",
    "release:verify-appimage": "node scripts/verify-linux-appimage.mjs",
    "test:release-tools": "node scripts/test-linux-appimage-tools.mjs",
    "spec:check": "node scripts/check-specification.mjs",
    "large-note-gate": "MEMOKA_RUN_LARGE_NOTE_GATE=1 vitest run tests/large-note-gate.test.ts --reporter=verbose",
    "verify": "corepack pnpm format:check && corepack pnpm spec:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm test:release-tools && cargo test -p memoka-desktop && corepack pnpm build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@tiptap/core": "3.29.0",
    "@tiptap/extension-code": "3.29.0",
    "@tiptap/extension-collaboration": "3.29.0",
    "@tiptap/extension-image": "3.29.0",
    "@tiptap/extension-link": "3.29.0",
    "@tiptap/extension-table": "3.29.0",
    "@tiptap/pm": "3.29.0",
    "@tiptap/react": "3.29.0",
    "@tiptap/starter-kit": "3.29.0",
    "@tiptap/y-tiptap": "3.0.7",
    "budoux": "0.9.1",
    "jittered-fractional-indexing": "1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "y-prosemirror": "1.3.7",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
