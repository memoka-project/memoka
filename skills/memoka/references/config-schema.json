{
  "cli_version": "0.3.2",
  "color": "#RRGGBB; no CSS, scripts, URLs or external files",
  "conflict": "expected_revision is SHA-256 of the exact config bytes; reread on conflict, no force or auto-rebase",
  "constraints": {
    "font_family": "deprecated alias of ui_font_family",
    "indent_width_px": "16..64",
    "japanese.line_break_segmentation": ["fine", "budoux", "native"],
    "japanese.word_segmentation": ["fine", "budoux", "unicode"],
    "line_number_min_width_px": "0 or 240..4096",
    "note_font_families": "1..256 UTF-8 bytes; no control characters, semicolons or braces",
    "note_gaps_em": "0.00..3.00, at most 2 decimal places",
    "note_line_height": "1.00..2.50, at most 2 decimal places",
    "note_max_width_px": "0 or 320..4096",
    "note_section_title_size_em": "0.80..3.00, at most 2 decimal places",
    "ui_font_family": "1..256 UTF-8 bytes; no control characters, semicolons or braces",
    "zoom_percent": "50..200, step 10"
  },
  "custom_theme": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "base": {
        "type": "string"
      },
      "name": {
        "type": ["string", "null"]
      },
      "palette": {
        "additionalProperties": {
          "type": "string"
        },
        "default": {},
        "type": "object"
      }
    },
    "required": ["base"],
    "title": "CustomTheme",
    "type": "object"
  },
  "custom_theme_key": "themes.<id> (replace one complete definition)",
  "get": "config get --format json",
  "limits": {
    "config_bytes": 262144,
    "edits": 128,
    "input_bytes": 262144,
    "themes": 64
  },
  "palette_fields": [
    "bg0",
    "bg1",
    "bg2",
    "bg3",
    "bg4",
    "fg0",
    "fg1",
    "fg2",
    "fg3",
    "selection",
    "selectionStrong",
    "comment",
    "black",
    "red",
    "green",
    "yellow",
    "blue",
    "magenta",
    "cyan",
    "white",
    "orange",
    "pink"
  ],
  "reload": "appearance and Japanese segmentation reload in running GUIs; keymaps and credentials are not writable here",
  "request": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "expected_revision": {
        "type": "string"
      },
      "schema_version": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "set": {
        "additionalProperties": true,
        "default": {},
        "type": "object"
      },
      "unset": {
        "default": [],
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": ["expected_revision", "schema_version"],
    "title": "ConfigRequest",
    "type": "object"
  },
  "schema_version": 1,
  "scope": "application",
  "set": "config set --input FILE|- --format json [--dry-run]",
  "set_keys": [
    "theme",
    "ui_font_family",
    "font_family",
    "note_japanese_font_family",
    "note_latin_font_family",
    "note_monospace_font_family",
    "note_line_height",
    "note_block_gap_em",
    "note_list_item_gap_em",
    "note_section_title_gap_before_em",
    "note_section_title_gap_after_em",
    "note_section_title_size_em",
    "zoom_percent",
    "note_max_width_px",
    "line_number_min_width_px",
    "indent_width_px",
    "japanese.word_segmentation",
    "japanese.line_break_segmentation"
  ],
  "theme_bases": [
    "nightfox",
    "dayfox",
    "dawnfox",
    "duskfox",
    "nordfox",
    "terafox",
    "carbonfox"
  ],
  "theme_id": "[a-z][a-z0-9-]{0,47}; built-in IDs are reserved"
}
